<%- include('partials/header', { title: title, url: url }) %>

    <section class="page-head">
      <h1 data-testid="new-title">Add a Habit</h1>
      <p class="tagline">What do you want to build a streak on?</p>
    </section>

    <% if (error) { %>
      <p class="form-error" data-testid="form-error"><%= error %></p>
    <% } %>

    <form class="habit-form" method="post" action="<%= url('/habits') %>">
      <label class="field">
        <span class="field-label">Name</span>
        <input
          type="text"
          name="name"
          data-testid="habit-name-input"
          placeholder="e.g. Meditate 10 minutes"
          required
          autofocus
        >
      </label>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-testid="create-habit">Create</button>
        <a class="btn btn-secondary" href="<%= url('/habits') %>">Cancel</a>
      </div>
    </form>

<%- include('partials/footer') %>
