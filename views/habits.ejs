<%- include('partials/header', { title: title, url: url }) %>

    <section class="page-head">
      <h1 data-testid="habits-title">My Habits</h1>
      <p class="tagline">Keep the momentum going — every streak starts with day one.</p>
    </section>

    <a class="btn btn-primary" href="<%= url('/habits/new') %>" data-testid="add-habit">Add Habit</a>

    <ul class="habit-list" data-testid="habits-main">
      <% habits.forEach(function (habit) { %>
        <li class="habit-row" data-testid="habit-item-<%= habit.id %>">
          <span class="habit-name"><%= habit.name %></span>
          <span class="habit-streak">🔥 <%= habit.streak %> day streak</span>
        </li>
      <% }); %>
    </ul>

<%- include('partials/footer') %>
